{
  "name": "legallens",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/src/index.ts",
    "build": "tsc && vite build && npm run build:server",
    "build:client": "tsc && vite build",
    "build:server": "tsc -p server/tsconfig.json && node -e \"require('fs').writeFileSync('dist-server/package.json', JSON.stringify({type:'commonjs'}))\"",
    "test:guardrails": "npx tsx server/src/tests/guardrails.test.ts",
    "test:granularity": "npx tsx server/src/tests/clause_granularity_density.test.ts",
    "test:bugs": "npx tsx server/src/tests/pipeline_bugs.test.ts && npx tsx server/src/tests/navigation_ui.test.ts",
    "test": "npx tsx server/src/tests/guardrails.test.ts && npx tsx server/src/tests/pipeline.test.ts && npx tsx server/src/tests/clause_granularity_density.test.ts && npx tsx server/src/tests/pipeline_bugs.test.ts && npx tsx server/src/tests/navigation_ui.test.ts",
    "start": "node dist-server/server/src/index.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "lucide-react": "^0.475.0",
    "multer": "^1.4.5-lts.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "tesseract.js": "^7.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.4",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.0.7",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.1"
  }
}
